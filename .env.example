# WhatsApp Bulk Messenger Server Configuration
PORT=5000
NODE_ENV=development

# Security & Authentication (Required: at least 32 characters in production)
JWT_SECRET=your_jwt_secret_min_32_characters_long_here
# Meta App Secret for verifying webhook X-Hub-Signature-256
META_APP_SECRET=your_meta_app_secret_here

# Meta WhatsApp Cloud API Configuration
WHATSAPP_API_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_here
META_GRAPH_VERSION=v21.0

# Broadcasting Defaults
DEFAULT_COUNTRY_CODE=91
BROADCAST_DELAY_MS=250

# Meta Webhook Verification Token
WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Optional: Public Webhook URL & CORS Allowed Origins
PUBLIC_WEBHOOK_URL=
CORS_ORIGIN=

# Local Storage (under this folder)
DATA_DIR=./data
UPLOADS_DIR=./uploads

# WhatsApp Flows Feature Configuration
WHATSAPP_FLOWS_ENABLED=false
FLOWS_PRIVATE_KEY=
FLOWS_PASSPHRASE=
FLOWS_ENDPOINT_URL=
